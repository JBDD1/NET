#!/bin/sh
# ══════════════════════════════════════════════════════════════
# FINOVA — Pre-commit: detectar secretos antes del commit
#
# La lógica vive en scripts/check-secrets.cjs (Node, sin dependencias).
# Antes estaba aquí en shell, y tenía tres problemas que importaban:
#
#   1. Imprimía las líneas coincidentes — es decir, escribía el secreto
#      encontrado en la terminal, y de ahí al scrollback o a un log.
#   2. Usaba `git diff --cached --diff-filter=A`, que solo mira ficheros
#      NUEVOS: un secreto pegado en un .env o un server.cjs que ya existía
#      no se escaneaba. Es el caso más probable en la práctica.
#   3. No exigía longitud mínima, así que bloqueaba por los EJEMPLOS
#      escritos en comentarios. Un detector que grita con los ejemplos se
#      desactiva con --no-verify, y desde ese momento no detecta nada.
#
# Se mantiene en .husky porque husky ya está instalado y configurado
# (core.hooksPath = .husky/_). Para el caso de un clon sin husky hay
# .githooks/pre-commit y `npm run hooks:install`.
# ══════════════════════════════════════════════════════════════

node scripts/check-secrets.cjs || exit 1

exit 0
