# Entorno de producción (Vercel)
# Este archivo SÍ puede commitearse (las Firebase client keys son públicas por diseño)
# IMPORTANTE: configura también estas variables en Vercel → Settings → Environment Variables

# Firebase (cliente — público por diseño según documentación de Google)
VITE_FIREBASE_API_KEY=AIzaSyBw0RiwDM-vcqJ_mXDZGz1xXy-rF6JjBqw
VITE_FIREBASE_AUTH_DOMAIN=finova-92100.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=finova-92100
VITE_FIREBASE_STORAGE_BUCKET=finova-92100.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=387946044101
VITE_FIREBASE_APP_ID=1:387946044101:web:9d6435d177a4b7ad92eeac

# URL del servidor vacía en producción: Vercel proxy enruta /api/* a Railway
VITE_SERVER_URL=
VITE_APP_ENV=production

# URL base a la que vuelven los enlaces de los correos de Firebase.
# VACIA a proposito: auth-shared.js cae a location.origin, asi que el enlace
# devuelve al usuario al mismo origen desde el que se registro. Es lo correcto
# mientras no haya dominio propio. Cuando lo haya, fijarla aqui (sin barra
# final) para que los correos apunten siempre al canonico, y anadir ese
# dominio a los dominios autorizados de Firebase. Ver AUTH_EMAIL_SETUP.md.
VITE_APP_URL=

# ─── Monitorizacion ──────────────────────────────────────────
# Todas OPCIONALES. Vacias = no se envia nada y la app funciona igual.
# Ver MONITORING_SETUP.md para como obtenerlas.

# DSN del proyecto de Sentry para el NAVEGADOR. Es publico por diseño (va
# en el bundle), pero no debe estar escrito en el codigo: va aqui.
VITE_SENTRY_DSN=

# Release: el hash del commit, para saber si un error es nuevo o viene de
# antes. En Vercel se puede poner VITE_RELEASE=$VERCEL_GIT_COMMIT_SHA.
VITE_RELEASE=

# Analitica sin cookies. SRC es la URL del script; ID el identificador del
# sitio. El dominio de SRC tiene que estar permitido en la CSP.
VITE_ANALYTICS_SRC=
VITE_ANALYTICS_ID=
