# ══════════════════════════════════════════════════════════════
# FINOVA — Variables del servidor (Railway)
# ══════════════════════════════════════════════════════════════
# Este archivo SÍ va a GitHub — es solo documentación (sin valores reales).
# Copia estas variables en: Railway → tu proyecto → Variables
#
# Cómo generar algunos valores:
#   JWT_SECRET:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   FINOVA_ENC_KEY:   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ══════════════════════════════════════════════════════════════

# ── Puerto (Railway lo asigna; 3000 en local) ─────────────────
PORT=3000

# ── Entorno ───────────────────────────────────────────────────
# Entorno. En 'production' el servidor NO sirve ficheros estáticos (los
# sirve Vercel) y exige ALLOWED_ORIGIN para arrancar.
NODE_ENV=production

# ─── Ficheros estáticos ────────────────────────────────────────
# SERVE_STATIC: si este proceso sirve el frontend además de /api/*.
#   Por defecto: true cuando NODE_ENV != 'production', false en producción.
#   En producción el frontend lo sirve Vercel, así que servirlo aquí es
#   superficie de ataque que no hace falta: el directorio del proyecto
#   contiene data/users/*.json, .env.*, .git/ y server.cjs.
#   Valores aceptados: 1/true/yes/on/si (y sus negaciones).
# SERVE_STATIC=false
#
# STATIC_DIR: desde qué directorio se sirven. Por defecto:
#   · dist/ cuando NODE_ENV=production
#   · la raíz del proyecto en desarrollo, y SOLO ahí, con una lista blanca
#     estricta de ficheros públicos encima.
#   Apuntarlo a dist/ es siempre más seguro que a la raíz, porque dist/ solo
#   contiene lo que el build publica.
# STATIC_DIR=./dist

# ─── Despliegue (ver DEPLOY.md) ────────────────────────────────
# HOST: interfaz de escucha. Por defecto 0.0.0.0 en produccion (el proxy del
#   hosting corre FUERA del contenedor y un bind a loopback es invisible
#   desde ahi) y 127.0.0.1 en local (no hay motivo para exponer el servidor
#   de desarrollo, con datos reales, a toda la red wifi).
# HOST=0.0.0.0
#
# DATA_DIR: donde se guardan los datos de usuario, los backups de sync, los
#   roles, la analitica y los cubos del rate limit.
#   Por defecto: data/ dentro del proyecto.
#   EN PRODUCCION esto importa: en la mayoria de los hostings el disco del
#   contenedor es EFIMERO, asi que data/ se borra en cada despliegue y con el
#   los datos de todos los usuarios. Monta un volumen persistente y apunta
#   DATA_DIR a su ruta. El servidor avisa en los logs si detecta que DATA_DIR
#   ha quedado dentro del proyecto, y NO arranca si no puede escribir ahi.
#   Consulta en la documentacion de tu proveedor como se declara un volumen.
# DATA_DIR=/data
#
# TRUST_PROXY_HOPS: cuantos proxies de confianza hay DELANTE del servidor.
#   0 (por defecto) = ninguno: se usa la IP de la conexion y se IGNORA
#     X-Forwarded-For por completo.
#   N = se toma el elemento N contando desde la DERECHA de X-Forwarded-For.
#   Desde la derecha y nunca desde la izquierda: la cabecera la construyen los
#   proxies anadiendo al final, asi que los ultimos elementos los puso
#   infraestructura de confianza y los primeros los puede escribir quien envia
#   la peticion. Con el valor mal puesto, los limites por IP o agrupan a todos
#   los usuarios en un cubo (si sale la IP del proxy) o no limitan nada.
#   Para calibrarlo: GET /api/admin/whoami con una cuenta de admin. Ver
#   DEPLOY.md, que explica como interpretar la respuesta.
# TRUST_PROXY_HOPS=1
#
# OPEN_BROWSER: pon 'false' para no abrir el navegador al arrancar. En
#   produccion no se abre nunca, asi que esto solo importa en local.
# OPEN_BROWSER=false

# ── CORS — tu dominio de Vercel ───────────────────────────────
ALLOWED_ORIGIN=https://tu-app.vercel.app

# ── Secreto compartido Vercel ↔ Railway ────────────────────────
# El proxy serverless de Vercel (api/[...path].js) añade la cabecera
# x-finova-proxy con este valor; server.cjs rechaza /api/* si no coincide.
# Debe configurarse IGUAL en Railway (FINOVA_PROXY_SECRET) y en Vercel
# (FINOVA_PROXY_SECRET + RAILWAY_URL apuntando a tu backend de Railway).
# Generar uno: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINOVA_PROXY_SECRET=

# ── Claves de IA (solo una es necesaria — Groq es gratis) ─────
FINOVA_GROQ_KEY=gsk_...
FINOVA_CLAUDE_KEY=sk-ant-...

# ── GoCardless — Open Banking PSD2 (opcional) ─────────────────
FINOVA_GC_SECRET_ID=
FINOVA_GC_SECRET_KEY=

# ── Firebase Admin SDK ────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n

# ── Proyecto Firebase (para verificar JWTs sin Admin SDK) ─────
FINOVA_FIREBASE_PROJECT=tu-proyecto

# ── Administrador(es) ─────────────────────────────────────────
FINOVA_ADMIN_EMAILS=tu-email@dominio.com

# ── Cifrado en reposo (AES-256-GCM) — genera uno aleatorio ───
FINOVA_ENC_KEY=
