# ══════════════════════════════════════════════════════════════
# FINOVA — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Secretos — NUNCA subir ────────────────────────────────────
.env.local
.env.*.local
.env.server
firebase-service-account.json
*-service-account.json
*serviceAccount*.json
*service_account*.json
*.pem
*.p12
*.key
*.cert

# ── Dependencias ──────────────────────────────────────────────
node_modules/

# ── Build de Vite ─────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Datos de usuarios (Railway los guarda en su disco) ────────
# data/ completo excluido para no subir datos privados
data/sync/
data/users/
data/analytics.json
data/ratelimit.json
data/roles.json
data/waitlist.json
data/extra_admins.json
data/bank_requisitions.json

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Editor ────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.suo
*.swp
*.swo

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tests ─────────────────────────────────────────────────────
coverage/
.nyc_output/
