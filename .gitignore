# ══════════════════════════════════════════════════════════════
# FINOVA — .gitignore
# ══════════════════════════════════════════════════════════════

# ── Secretos — NUNCA subir ────────────────────────────────────
.env.local
.env.*.local
.env.server
firebase-service-account.json
*service-account*.json
*serviceAccount*.json
*service_account*.json
*firebase-adminsdk*.json
*.pem
*.p12
*.key
*.cert
*.pfx
google-credentials*.json
gcloud-*.json
.env.staging

# Las plantillas y la configuracion PUBLICA de Firebase si van versionadas:
# .env.example, .env.server.example, .env.development y .env.production solo
# contienen variables VITE_*, que acaban en el bundle del navegador de todas
# formas. Se declaran como excepcion explicita para que un patron futuro mas
# amplio (p.ej. ".env*") no las saque del repositorio sin que nadie lo note.
!.env.example
!.env.server.example
!.env.development
!.env.production

# ── Bases de datos locales ────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ── Dependencias ──────────────────────────────────────────────
node_modules/

# ── Build de Vite ─────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Datos de usuarios (Railway los guarda en su disco) ────────
# data/ completo excluido para no subir datos privados
# carpeta entera: asi un fichero de datos NUEVO tambien queda fuera
data/
data/sync/
data/users/
data/analytics.json
data/ratelimit.json
data/roles.json
data/waitlist.json
data/extra_admins.json
data/bank_requisitions.json

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── Editor / herramientas locales ──────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.suo
*.swp
*.swo
.claude/settings.local.json

# ── Temporales ──────────────────────────────────────────────────
tmp/
.cache/
*.tmp

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Tests ─────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Copias de seguridad y volcados ────────────────────────────
# Un backups/ con el dataset exportado, o un .tar.gz del proyecto, es el
# mismo problema que cerrar la exposición de ficheros estáticos: datos
# reales fuera de su sitio. Aquí publicados en GitHub en vez de servidos
# por HTTP, que es peor porque no se puede retirar.
backups/
*.tar.gz
*.tgz
*.zip
*.enc
*.dump
*.sql
