# ── Dependencias ──────────────────────────────────────────────
node_modules/

# ── Build de Vite ─────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Variables de entorno con secretos ─────────────────────────
# .env sin sufijo y .env.local contienen secrets reales → nunca al repo
.env
.env.local
.env.*.local
# .env.development y .env.production SÍ se committean
# (solo contienen Firebase client keys, públicas por diseño)

# ── Datos de usuarios (Railway los tiene en su propio disco) ──
# Se excluye data/ completo para evitar subir datos privados
data/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Editor ────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/

# ── Sistema operativo ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Certificados locales ──────────────────────────────────────
*.pem
*.key
*.cert

# ── Firebase service account — NUNCA subir al repo ────────────
firebase-service-account.json
*service-account*.json
