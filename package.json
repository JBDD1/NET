{
  "name": "finova",
  "version": "1.0.0",
  "description": "Gestión financiera personal",
  "private": true,
  "type": "module",
  "scripts": {
    "generate-icons":   "node scripts/generate-icons.js",
    "generate-branding":"node branding/scripts/generate-icons.js",
    "dev":              "vite",
    "build":            "vite build --mode production",
    "build:dev":        "vite build --mode development",
    "build:gh":         "cross-env VITE_BASE=/FinovaKimi/ vite build --mode production",
    "preview":          "vite preview",
    "start":            "node server.cjs",
    "test":             "node --experimental-vm-modules node_modules/.bin/jest",
    "release":          "bash scripts/release.sh",
    "version:patch":    "node -e \"const p=require('./package.json');const v=p.version.split('.').map(Number);v[2]++;require('fs').writeFileSync('package.json',JSON.stringify({...p,version:v.join('.')},null,2)+'\\n')\" && git add package.json && git commit -m \"chore: bump version\" && git tag -a v$(node -p \"require('./package.json').version\") -m 'release' && git push origin --tags && echo 'Tag creado y pusheado'"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "vite": "^5.2.0",
    "terser": "^5.31.0",
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "cross-env": "^7.0.3"
  }
}
