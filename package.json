{
  "name": "finova",
  "version": "1.0.0",
  "description": "Gestión financiera personal",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-branding": "node branding/scripts/generate-icons.js",
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "build:gh": "cross-env VITE_BASE=/NET/ vite build --mode production",
    "preview": "vite preview",
    "start": "node server.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:security": "node --test tests/static-guard.test.cjs",
    "test:isolation": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/tests/isolation.test.js --testTimeout=15000",
    "release": "bash scripts/release.sh",
    "version:patch": "node -e \"const p=require('./package.json');const v=p.version.split('.').map(Number);v[2]++;require('fs').writeFileSync('package.json',JSON.stringify({...p,version:v.join('.')},null,2)+'\\n')\" && git add package.json && git commit -m \"chore: bump version\" && git tag -a v$(node -p \"require('./package.json').version\") -m 'release' && git push origin --tags && echo 'Tag creado y pusheado'",
    "build:sentry": "bash scripts/upload-sourcemaps.sh"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "@sentry/node": "^11.10.0",
    "firebase-admin": "^14.3.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "terser": "^5.31.0",
    "vite": "^6.4.3"
  }
}
